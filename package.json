{
  "name": "openbox",
  "version": "1.0.0",
  "description": "OpenBox - Document ingestion and RAG pipeline",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
