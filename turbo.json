{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "db:generate": {
      "dependsOn": ["^build"]
    },
    "db:migrate": {
      "dependsOn": ["^build"]
    },
    "db:studio": {
      "cache": false
    }
  },
  "globalEnv": ["MISTRAL_API_KEY", "NVIDIA_API_KEY", "OPENROUTER_API_KEY", "TYPESAFE_API_KEY", "OPENAI_API_KEY", "GROQ_API_KEY", "DEEPSEEK_API_KEY", "TOGETHER_API_KEY", "XAI_API_KEY", "COHERE_API_KEY", "GEMINI_API_KEY", "FIREWORKS_API_KEY", "JINA_API_KEY", "DATABASE_URL", "REDIS_URL"]
}