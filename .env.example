# OpenBox Environment Variables
# NOTE: Generate all secrets with: openssl rand -hex 32 (or -hex 64 for longer keys)

# =============================================================================
# REQUIRED: Core Secrets
# =============================================================================

# Session secret for JWT signing (HS256)
# MUST be a long random string (64+ characters)
# DO NOT use the same value as API_KEY
SESSION_SECRET=generate_with_openssl_rand_hex_64

# Master API key for operator-level access
# Used for authentication when API_KEY header matches this value
API_KEY=generate_with_openssl_rand_hex_32

# =============================================================================
# LLM Providers
# =============================================================================

# Mistral AI (embeddings + answers)
MISTRAL_API_KEY=your_mistral_api_key_here

# NVIDIA NIM (Nemotron embeddings)
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenRouter (third-party models, e.g. NVIDIA Nemotron answers)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# TypeSafe (Jev judge)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# =============================================================================
# Optional Providers (Settings -> Orchestration)
# =============================================================================
# These keys are used by the ingestion/query pipeline for inference
# The key you paste in the UI is only used to list models (transient, never stored)

# OpenAI
OPENAI_API_KEY=

# Groq
GROQ_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Together AI
TOGETHER_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Cohere
COHERE_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Fireworks AI
FIREWORKS_API_KEY=

# Jina AI
JINA_API_KEY=

# =============================================================================
# Database
# =============================================================================
# PostgreSQL with pgvector
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openbox

# =============================================================================
# Redis (for BullMQ queue)
# =============================================================================
# Format: redis://[:password@]host:port
# For production, ALWAYS set a password
REDIS_URL=redis://localhost:6379

# =============================================================================
# API Server Configuration
# =============================================================================
PORT=3000
HOST=0.0.0.0

# =============================================================================
# Security Settings
# =============================================================================

# CORS: comma-separated list of allowed origins
# Example: https://app.example.com,https://admin.example.com
# WARNING: Do NOT use "*" in production - this allows any website to make requests
# Default (empty) means only same-origin requests are allowed
ALLOWED_ORIGINS=

# =============================================================================
# File Upload Settings
# =============================================================================
# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown
