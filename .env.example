# OpenBox Environment Variables

# LLM Provider (Mistral for embeddings + answers)
MISTRAL_API_KEY=your_mistral_api_key_here

# NVIDIA NIM (Nemotron embeddings)
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenRouter (third-party models, e.g. NVIDIA Nemotron answers)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# TypeSafe (Jev judge)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional providers (Settings → Orchestration). The key you paste in the UI
# is used only to list models; these server keys are what the ingestion/query
# pipeline uses to actually run inference with each provider.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# COHERE_API_KEY=
# GEMINI_API_KEY=
# FIREWORKS_API_KEY=
# JINA_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openbox

# Redis (for BullMQ queue)
REDIS_URL=redis://localhost:6379

# API Server
PORT=3000
HOST=0.0.0.0

# API Authentication (optional but recommended for production)
# Set a long random string: openssl rand -hex 32
API_KEY=your_api_key_here

# CORS (optional) - comma-separated origins, or * for all
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com