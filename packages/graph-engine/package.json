{
  "name": "@openbox/graph-engine",
  "version": "1.0.0",
  "description": "Graph extraction and querying engine for OpenBox",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^1.0.0",
    "ai": "^4.0.0",
    "zod": "^3.23.0",
    "@openbox/shared-types": "workspace:*",
    "@openbox/llm-provider": "workspace:*",
    "@openbox/db": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}