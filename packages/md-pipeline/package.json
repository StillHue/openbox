    "mammoth": "^1.8.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.0",
    "unpdf": "^0.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@openbox/shared-types": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
