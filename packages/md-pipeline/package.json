{
  "name": "@openbox/md-pipeline",
  "version": "1.0.0",
  "description": "Markdown conversion and chunking pipeline",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
