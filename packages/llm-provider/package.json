{
  "name": "@openbox/llm-provider",
  "version": "1.0.0",
  "description": "LLM provider wrapper using Vercel AI SDK with Mistral",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^1.0.0",
    "@ai-sdk/provider": "1.1.3",
    "ai": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@openbox/shared-types": "workspace:*",
    "@types/node": "^22.20.4",
    "typescript": "^5.4.0"
  }
}