FROM node:22-alpine

WORKDIR /app

# Force cache bust - change this to invalidate cache
ARG CACHE_BUST=1

# Install pnpm
RUN npm install -g pnpm@11.1.2

# Copy package files first for better caching
COPY package*.json ./
COPY pnpm-workspace.yaml ./
COPY turbo.json ./
COPY tsconfig.json ./

# Copy all workspace packages
COPY packages ./packages
COPY apps/worker ./apps/worker

# Copy lockfile
COPY pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Build all packages (respecting dependency order via turbo)
RUN pnpm build

# Start the worker
CMD ["pnpm", "run", "--filter", "@openbox/worker", "start"]
