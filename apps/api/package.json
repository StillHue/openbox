{
  "name": "@openbox/api",
  "version": "1.0.0",
  "description": "OpenBox API server with Fastify",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "@fastify/multipart": "^8.3.0",
