    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.0",
    "zod": "^3.23.0",
    "uuid": "^10.0.0",
    "pino": "^9.0.0",
    "@openbox/shared-types": "workspace:*",
    "@openbox/db": "workspace:*",
    "@openbox/llm-provider": "workspace:*"
